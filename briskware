-- Tabs
local ActiveTab
local function CreateTab(name)
    local tab = {}
    tab.Button = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = THEME.Sidebar, Text = name,
        Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = THEME.SubText,
        AutoButtonColor = false, Parent = TabList,
    }, {corner(6)})
    tab.Page = new("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, Parent = Content,
    }, {new("UIListLayout", {Padding = UDim.new(0, 6)})})

    local function select()
        if ActiveTab then
            ActiveTab.Page.Visible = false
            tween(ActiveTab.Button, {BackgroundColor3 = THEME.Sidebar, TextColor3 = THEME.SubText})
        end
        ActiveTab = tab
        tab.Page.Visible = true
        tween(tab.Button, {BackgroundColor3 = THEME.Accent, TextColor3 = THEME.Text})
    end
    tab.Button.MouseButton1Click:Connect(select)
    if not ActiveTab then select() end

    function tab:CreateModule(cfg)
        local module = {Enabled = false}
        local frame = new("Frame", {
            Size = UDim2.new(1, -6, 0, 36), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = THEME.Module, BorderSizePixel = 0, Parent = tab.Page,
        }, {corner(6), new("UIListLayout", {})})
        local header = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Text = "", LayoutOrder = 0, Parent = frame,
        })
        local label = new("TextLabel", {
            Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
            Text = cfg.Name or "Module", Font = Enum.Font.GothamMedium, TextSize = 13,
            TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = header,
        })
        local arrow = new("TextButton", {
            Size = UDim2.fromOffset(30, 36), Position = UDim2.new(1, -32, 0, 0), BackgroundTransparency = 1,
            Text = "+", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = THEME.SubText, Parent = header,
        })
        local options = new("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = THEME.Option,
            BorderSizePixel = 0, Visible = false, LayoutOrder = 1, Parent = frame,
        }, {new("UIListLayout", {Padding = UDim.new(0, 2)}),
            new("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)})})

        function module:SetEnabled(state)
            module.Enabled = state
            tween(frame, {BackgroundColor3 = state and THEME.Accent or THEME.Module})
            tween(label, {TextColor3 = state and THEME.Text or THEME.SubText})
            if cfg.Callback then task.spawn(cfg.Callback, state) end
        end
        header.MouseButton1Click:Connect(function() module:SetEnabled(not module.Enabled) end)
        arrow.MouseButton1Click:Connect(function()
            options.Visible = not options.Visible
            arrow.Text = options.Visible and "-" or "+"
        end)

        function module:AddToggle(c)
            local state = c.Default or false
            local row = new("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", Parent = options})
            new("TextLabel", {
                Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
                Text = c.Name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = THEME.Text,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
            })
            local track = new("Frame", {
                Size = UDim2.fromOffset(30, 14), Position = UDim2.new(1, -42, 0.5, -7),
                BackgroundColor3 = state and THEME.Accent or THEME.Module, Parent = row,
            }, {corner(7)})
            local knob = new("Frame", {
                Size = UDim2.fromOffset(10, 10),
                Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
                BackgroundColor3 = THEME.Text, Parent = track,
            }, {corner(5)})
            row.MouseButton1Click:Connect(function()
                state = not state
                tween(track, {BackgroundColor3 = state and THEME.Accent or THEME.Module})
                tween(knob, {Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)})
                if c.Callback then task.spawn(c.Callback, state) end
            end)
        end

        function module:AddSlider(c)
            local min, max = c.Min or 0, c.Max or 100
            local value = c.Default or min
            local row = new("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = options})
            local text = new("TextLabel", {
                Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 2), BackgroundTransparency = 1,
                Text = c.Name .. ": " .. value, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = THEME.Text,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
            })
            local bar = new("Frame", {
                Size = UDim2.new(1, -24, 0, 8), Position = UDim2.fromOffset(12, 26),
                BackgroundColor3 = THEME.Module, Parent = row,
            }, {corner(4)})
            local fill = new("Frame", {
                Size = UDim2.fromScale((value - min) / (max - min), 1), BackgroundColor3 = THEME.Accent, Parent = bar,
            }, {corner(4)})
            local sliding = false
            local function update(x)
                local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * pct + 0.5)
                fill.Size = UDim2.fromScale(pct, 1)
                text.Text = c.Name .. ": " .. value
                if c.Callback then task.spawn(c.Callback, value) end
            end
            bar.InputBegan:Connect(function(i) if isPress(i) then sliding = true; update(i.Position.X) end end)
            UIS.InputChanged:Connect(function(i) if sliding and isMove(i) then update(i.Position.X) end end)
            UIS.InputEnded:Connect(function(i) if isPress(i) then sliding = false end end)
        end

        function module:AddDropdown(c)
            local index = 1
            local btn = new("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", Parent = options})
            local lbl = new("TextLabel", {
                Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
                Text = c.Name .. ": " .. c.Options[1], Font = Enum.Font.Gotham, TextSize = 12,
                TextColor3 = THEME.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn,
            })
            btn.MouseButton1Click:Connect(function()
                index = index % #c.Options + 1
                lbl.Text = c.Name .. ": " .. c.Options[index]
                if c.Callback then task.spawn(c.Callback, c.Options[index]) end
            end)
        end

        if cfg.Default then module:SetEnabled(true) end
        return module
    end

    return tab
end

