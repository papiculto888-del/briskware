--// Notifications (bottom right)
local NotifHolder = new("Frame", {
    Size = UDim2.new(0, 270, 1, -20), Position = UDim2.new(1, -280, 0, 10),
    BackgroundTransparency = 1, Parent = Gui,
}, {new("UIListLayout", {
    Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
    VerticalAlignment = Enum.VerticalAlignment.Bottom,
    HorizontalAlignment = Enum.HorizontalAlignment.Right,
})})

local function Notify(title, text, duration)
    duration = duration or 3
    local n = new("Frame", {
        Size = UDim2.fromOffset(270, text and text ~= "" and 62 or 40),
        BackgroundColor3 = Color3.fromRGB(28, 28, 30), BorderSizePixel = 0,
        ClipsDescendants = true, Parent = NotifHolder,
    }, {corner(6)})
    new("TextLabel", {
        Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(10, 10),
        BackgroundColor3 = C.Text, Text = "i", Font = Enum.Font.GothamBold, TextSize = 12,
        TextColor3 = Color3.fromRGB(28, 28, 30), Parent = n,
    }, {corner(9)})
    new("TextLabel", {
        Size = UDim2.new(1, -44, 0, 20), Position = UDim2.fromOffset(38, 9), BackgroundTransparency = 1,
        Text = title, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = C.White,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = n,
    })
    if text and text ~= "" then
        new("TextLabel", {
            Size = UDim2.new(1, -44, 0, 26), Position = UDim2.fromOffset(38, 30), BackgroundTransparency = 1,
            Text = text, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.Sub, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = n,
        })
    end
    local bar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = C.White, BorderSizePixel = 0, Parent = n,
    })
    TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()
    task.delay(duration, function() n:Destroy() end)
end

--// Dragging (one global handler, divides by UI scale)
local drag, zCounter = nil, 1
UIS.InputChanged:Connect(function(i)
    if drag and isMove(i) then
        local d = (i.Position - drag.start) / scale
        drag.panel.Position = UDim2.fromOffset(drag.origin.X + d.X, drag.origin.Y + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if isPress(i) then drag = nil end
end)

local Panels, AllModules, Modules = {}, {}, {}

--// Panel shell
local function createPanel(title, accent)
    local panel = {Accent = accent, Modules = {}, Collapsed = false}

    panel.Frame = new("Frame", {
        Size = UDim2.fromOffset(PANEL_W, HEAD_H), BackgroundColor3 = C.Panel,
        BorderSizePixel = 0, ClipsDescendants = true, Parent = Root,
    }, {corner(6)})

    local header = new("Frame", {
        Size = UDim2.new(1, 0, 0, HEAD_H), BackgroundTransparency = 1, Parent = panel.Frame,
    })
    new("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(12, 12),
        BackgroundColor3 = accent, BorderSizePixel = 0, Parent = header,
    }, {corner(4)})
    new("TextLabel", {
        Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(34, 0), BackgroundTransparency = 1,
        Text = title, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = C.Text,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = header,
    })
    local chevron = new("TextButton", {
        Size = UDim2.fromOffset(34, HEAD_H), Position = UDim2.new(1, -36, 0, 0), BackgroundTransparency = 1,
        Text = "v", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.Sub, Parent = header,
    })

    panel.Body = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromOffset(0, HEAD_H),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y, Parent = panel.Frame,
    })
    local layout = new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = panel.Body})

    local function resize()
        local bodyH = math.min(layout.AbsoluteContentSize.Y, MAX_BODY)
        panel.Body.Size = UDim2.new(1, 0, 0, bodyH)
        panel.Frame.Size = UDim2.fromOffset(PANEL_W, HEAD_H + (panel.Collapsed and 0 or bodyH))
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
    resize()

    chevron.MouseButton1Click:Connect(function()
        panel.Collapsed = not panel.Collapsed
        panel.Body.Visible = not panel.Collapsed
        chevron.Text = panel.Collapsed and "^" or "v"
        resize()
    end)

    header.InputBegan:Connect(function(i)
        if isPress(i) then
            zCounter += 1
            panel.Frame.ZIndex = zCounter
            drag = {
                panel = panel.Frame, start = i.Position,
                origin = Vector2.new(panel.Frame.Position.X.Offset, panel.Frame.Position.Y.Offset),
            }
        end
    end)

    table.insert(Panels, panel)
    return panel
end

--// Module rows
local function addModule(panel, def)
    local m = {Name = def.Name, Enabled = false}
    local accent = panel.Accent

    local container = new("Frame", {
        Size = UDim2.new(1, 0, 0, ROW_H), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = #panel.Modules + 1, Parent = panel.Body,
    }, {new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder})})

    local row = new("TextButton", {
        Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = C.Row, BorderSizePixel = 0,
        AutoButtonColor = false, Text = "", LayoutOrder = 0, Parent = container,
    })
    local label = new("TextLabel", {
        Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
        Text = def.Name, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = C.Text,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })

    local right = -34
    if def.Badge then
        new("TextLabel", {
            Size = UDim2.fromOffset(62, 16), Position = UDim2.new(1, right - 62, 0.5, -8),
            BackgroundColor3 = accent, Text = def.Badge, Font = Enum.Font.GothamBold,
            TextSize = 9, TextColor3 = C.White, Parent = row,
        }, {corner(4)})
        right = right - 66
    end
    if def.Star then
        new("TextLabel", {
            Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, right - 18, 0.5, -9),
            BackgroundTransparency = 1, Text = "★", Font = Enum.Font.GothamBold, TextSize = 16,
            TextColor3 = Color3.fromRGB(255, 150, 30), Parent = row,
        })
    end

    local dots = new("TextButton", {
        Size = UDim2.fromOffset(30, ROW_H), Position = UDim2.new(1, -32, 0, 0),
        BackgroundTransparency = 1, Text = "", Parent = row,
    })
    for k = 0, 2 do
        new("Frame", {
            Size = UDim2.fromOffset(3, 3), Position = UDim2.new(0.5, -1, 0.5, -8 + k * 6),
            BackgroundColor3 = C.Sub, BorderSizePixel = 0, Parent = dots,
        }, {corner(2)})
    end

    local options = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = C.Options, BorderSizePixel = 0, Visible = false, LayoutOrder = 1, Parent = container,
    }, {
        new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}),
        new("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)}),
    })
    local empty = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "No settings yet",
        Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.Sub, Parent = options,
    })
    local function used() if empty then empty:Destroy(); empty = nil end end

    function m:SetEnabled(state, quiet)
        m.Enabled = state
        tween(row, {BackgroundColor3 = state and accent or C.Row})
        tween(label, {TextColor3 = state and C.White or C.Text})
        if not quiet then Notify(def.Name, state and "Enabled" or "Disabled", 1.5) end
        if def.Callback then task.spawn(def.Callback, state) end
    end

    row.MouseEnter:Connect(function() if not m.Enabled then tween(row, {BackgroundColor3 = C.RowHover}) end end)
    row.MouseLeave:Connect(function() if not m.Enabled then tween(row, {BackgroundColor3 = C.Row}) end end)
    row.MouseButton1Click:Connect(function() m:SetEnabled(not m.Enabled) end)
    row.MouseButton2Click:Connect(function() options.Visible = not options.Visible end)
    dots.MouseButton1Click:Connect(function() options.Visible = not options.Visible end)

    function m:AddToggle(c)
        used()
        local state = c.Default or false
        local r = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", Parent = options,
        })
        new("TextLabel", {
            Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
            Text = c.Name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = r,
        })
        local track = new("Frame", {
            Size = UDim2.fromOffset(30, 14), Position = UDim2.new(1, -42, 0.5, -7),
            BackgroundColor3 = state and accent or Color3.fromRGB(50, 50, 55), Parent = r,
        }, {corner(7)})
        local knob = new("Frame", {
            Size = UDim2.fromOffset(10, 10),
            Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
            BackgroundColor3 = C.White, Parent = track,
        }, {corner(5)})
        r.MouseButton1Click:Connect(function()
            state = not state
            tween(track, {BackgroundColor3 = state and accent or Color3.fromRGB(50, 50, 55)})
            tween(knob, {Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)})
            if c.Callback then task.spawn(c.Callback, state) end
        end)
    end

    function m:AddSlider(c)
        used()
        local min, max = c.Min or 0, c.Max or 100
        local value = c.Default or min
        local r = new("Frame", {Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, Parent = options})
        local text = new("TextLabel", {
            Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 3), BackgroundTransparency = 1,
            Text = c.Name .. ": " .. value, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = r,
        })
        local bar = new("Frame", {
            Size = UDim2.new(1, -24, 0, 8), Position = UDim2.fromOffset(12, 26),
            BackgroundColor3 = Color3.fromRGB(50, 50, 55), Parent = r,
        }, {corner(4)})
        local fill = new("Frame", {
            Size = UDim2.fromScale((value - min) / (max - min), 1), BackgroundColor3 = accent, Parent = bar,
        }, {corner(4)})
        local sliding = false
        local function update(x)
            local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * pct + 0.5)
            fill.Size = UDim2.fromScale(pct, 1)
            text.Text = c.Name .. ": " .. value
            if c.Callback then task.spawn(c.Callback, value) end
        end
        bar.InputBegan:Connect(function(i) if isPress(i) then sliding = true; update(i.Position.X) end end)
        UIS.InputChanged:Connect(function(i) if sliding and isMove(i) then update(i.Position.X) end end)
        UIS.InputEnded:Connect(function(i) if isPress(i) then sliding = false end end)
    end

    function m:AddDropdown(c)
        used()
        local index = 1
        local b = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", Parent = options,
        })
        local l = new("TextLabel", {
            Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
            Text = c.Name .. ": " .. c.Options[1], Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = b,
        })
        b.MouseButton1Click:Connect(function()
            index = index % #c.Options + 1
            l.Text = c.Name .. ": " .. c.Options[index]
            if c.Callback then task.spawn(c.Callback, c.Options[index]) end
        end)
    end

    table.insert(panel.Modules, m)
    table.insert(AllModules, {Name = def.Name, Container = container})
    Modules[def.Name] = m
    return m
end

