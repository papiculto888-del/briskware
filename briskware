            local text = new("TextLabel", {
                Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 2),
                BackgroundTransparency = 1, Text = c.Name .. ": " .. value, Font = Enum.Font.Gotham,
