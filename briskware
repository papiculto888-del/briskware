local searchBar = new("Frame", {
    Size = UDim2.fromOffset(280, 36), Position = UDim2.new(0.5, -140, 0, 12),
    BackgroundColor3 = C.Panel, BorderSizePixel = 0, Parent = Root,
}, {corner(6)})
local search = new("TextBox", {
    Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
    Text = "", PlaceholderText = "Search modules...", PlaceholderColor3 = C.Sub, ClearTextOnFocus = false,
    Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
    Parent = searchBar,
})
search:GetPropertyChangedSignal("Text"):Connect(function()
    local q = search.Text:lower()
    for _, m in ipairs(AllModules) do
        m.Container.Visible = q == "" or m.Name:lower():find(q, 1, true) ~= nil
    end
end)

